{
  "name": "@jakedowns/assistant-voice-opencode-plugin",
  "version": "0.0.4",
  "description": "Local text-to-speech for OpenCode: Piper voice tools, auto-speak, and audio panels for the TUI and desktop GUI",
  "type": "module",
  "main": "./index.ts",
  "files": [
    "index.ts",
    "rpc.ts",
    "state.ts",
    "commands.ts",
    "tui.js",
    "gui-experimental.cjs",
    "src",
    "README.md",
    "PROPOSAL.md"
  ],
  "scripts": {
    "build": "npm run build:tui && npm run build:gui",
    "build:tui": "esbuild src/tui.tsx --bundle --format=esm --platform=node --target=node20 --jsx=automatic --jsx-import-source=@opentui/solid --external:@opencode/plugin/tui --external:solid-js --external:'solid-js/*' --external:'@opentui/*' --outfile=tui.js",
    "build:gui": "vite build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@opencode/plugin": "^2.3.0"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "solid-js": "^1.9.0",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Jake Downs <mail@jakedowns.com>",
  "homepage": "https://github.com/jakedowns/opencode-helpers/tree/main/packages/audio-tool/plugin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jakedowns/opencode-helpers.git",
    "directory": "packages/audio-tool/plugin"
  },
  "bugs": {
    "url": "https://github.com/jakedowns/opencode-helpers/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tts",
    "text-to-speech",
    "piper",
    "voice",
    "audio",
    "accessibility"
  ]
}
