// Load the local plugin for sessions in this repository.
// Auto-speak is ON for this project while the stub is being exercised.
// Mute from the palette (Voice group) or tools.voice.control. (build 3)
{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    {
      "package": "./plugin",
      "options": {
        "root": "/media/share/opencode-audio-tool",
        "auto": true,
        "maxChars": 2000,
        "emptyNotice": "{session} here: my last message was untranscribable, check the app"
      }
    }
  ]
}
