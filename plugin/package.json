{
  "name": "assistant-voice-opencode-plugin",
  "version": "0.0.1",
  "description": "Local text-to-speech for OpenCode replies through the Piper queue",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./tui": "./dist/tui.js"
  },
  "scripts": {
    "build": "esbuild tui.tsx --bundle --format=esm --platform=node --target=node20 --external:@opencode/plugin/tui --external:solid-js --external:'solid-js/*' --external:'@opentui/*' --outfile=dist/tui.js"
  },
  "dependencies": {
    "@opencode/plugin": "^2.3.0"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "files": [
    "index.ts",
    "tui.tsx",
    "state.ts",
    "dist",
    "README.md",
    "PROPOSAL.md"
  ]
}
